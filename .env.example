# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram: https://t.me/botfather
# Format: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your chat ID by:
# 1. Add your bot to a group or start a conversation with it
# 2. Send a message: /start or any message
# 3. Visit: https://api.telegram.org/botYOUR_BOT_TOKEN/getUpdates
# 4. Look for the "chat" -> "id" field
VITE_TELEGRAM_CHAT_ID=your_chat_id_here
